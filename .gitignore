# raw crime CSVs (66MB, prep-time only, routing.py/app.py never touch them)
/*_crime_data.csv
data/*.csv
# osmnx HTTP cache
cache/

# data/safepath.db + data/walk.graphml + data/walk.pkl are committed on purpose:
# routing.py loads them at runtime (GRAPH_PATH/PICKLE_PATH/DB_PATH), so a fresh
# clone/deploy needs them present without re-running prep_data.py. walk.pkl is a
# prep-derived pickle cache that load_graph reads first to avoid parsing 31MB
# GraphML every cold start (serverless timeout fix).

# python
__pycache__/
*.pyc
.venv/
venv/
.env

# os
.DS_Store
